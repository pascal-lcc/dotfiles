# network interface settings; autogenerated
# Please do NOT modify this file directly, unless you know what
# you're doing.
#
# If you want to manage parts of the network configuration manually,
# please utilize the 'source' or 'source-directory' directives to do
# so.
# PVE will preserve these directives, but will NOT read its network
# configuration from sourced files, so do not attempt to move any of
# the PVE managed interfaces into external files!

auto lo
iface lo inet loopback

iface eth0 inet manual

iface eth1 inet manual

iface loopback0 inet manual

auto vmbr1
iface vmbr1 inet static
    address 10.10.10.1/24
    bridge-ports none
    bridge-stp off
    bridge-fd 0
    mtu 1420
    # 啟動時先嘗試刪除舊表（預防性清理），再建立新的
    post-up nft delete table ip pve_nat || true
    post-up nft add table ip pve_nat
    post-up nft 'add chain ip pve_nat postrouting { type nat hook postrouting priority 100 ; }'
    # 這裡加入 MSS Clamping 鏈與規則
    post-up nft 'add chain ip pve_nat forward { type filter hook forward priority 0 ; }'
    post-up nft 'add rule ip pve_nat forward tcp flags syn tcp option maxseg size set rt mtu'
    post-up nft 'add rule ip pve_nat postrouting ip saddr 10.10.10.0/24 ip daddr != 10.10.0.0/16 masquerade'

auto vmbr2
iface vmbr2 inet static
    address 10.10.20.1/24
    bridge-ports none
    bridge-stp off
    bridge-fd 0
    mtu 1420
    # vmbr2 只需要追加規則即可
    post-up nft 'add rule ip pve_nat postrouting ip saddr 10.10.20.0/24 ip daddr != 10.10.0.0/16 masquerade'

